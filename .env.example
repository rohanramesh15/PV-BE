# Backend Configuration Template
# Copy this file to .env and fill in your values

# Replicate API Token (required for CLIP image comparison)
# Get yours at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Server Port (default: 5001 for local, 8080 for Docker/Cloud)
PORT=5001

# CORS Allowed Origins (comma-separated list)
# For local development with both frontends:
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5000

# For production on Render.com:
# CORS_ORIGINS=https://your-user-frontend.onrender.com,https://your-display-frontend.onrender.com

# For ngrok testing (add your ngrok URLs):
# CORS_ORIGINS=http://localhost:3001,http://localhost:3002,https://your-ngrok-user.ngrok-free.app,https://your-ngrok-display.ngrok-free.app

# Flask Environment
FLASK_ENV=development
# FLASK_ENV=production
